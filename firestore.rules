rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      match /conversations/{conversationId} {
        function isConversationParticipant(data) {
          return request.auth != null
            && data.participantIds is list
            && data.participantIds.size() == 2
            && userId in data.participantIds
            && request.auth.uid in data.participantIds;
        }

        allow read: if isConversationParticipant(resource.data);
        allow create: if isConversationParticipant(request.resource.data);
        allow update: if isConversationParticipant(resource.data)
          && isConversationParticipant(request.resource.data);

        match /messages/{messageId} {
          function isParticipant() {
            let participants = get(
              /databases/$(database)/documents/users/$(userId)/conversations/$(conversationId)
            ).data.participantIds;
            return request.auth != null
              && participants is list
              && userId in participants
              && request.auth.uid in participants;
          }

          allow read: if isParticipant();
          allow create: if isParticipant()
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0;
          allow update: if isParticipant()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isRead'])
            && request.resource.data.isRead == true;
        }
      }
    }
  }
}